# EC2에 `.env`로 복사해 채운다. `.env`는 커밋하지 않는다(루트 .gitignore).
# compose.yaml·compose.data.yaml이 둘 다 이 파일을 읽는다.

# Docker Hub 계정·조직명. image: <여기>/dero-api:<태그>
DOCKERHUB_NAMESPACE=

# 데이터베이스. compose.data.yaml이 초기화에, compose.yaml이 접속에 쓴다.
# 로컬 개발은 POSTGRES_PASSWORD=derobe — 커밋된 application-local.yaml의 datasource와 짝이다.
# EC2만 실값으로 교체한다. 값은 볼륨이 빌 때만 먹는다(dero-api/CLAUDE.md 함정 참고).
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=

# 소셜 로그인·JWT 시크릿. compose.yaml이 컨테이너 env로 통과시키고
# application-prod.yaml의 ${OAUTH_*}·${APP_JWT_SECRET} placeholder가 바인딩한다(ADR-0010).
# client-id는 비밀이 아니지만(OAuth 흐름에서 브라우저에 노출된다) 배포 환경마다 등록된 앱이 달라
# 이 파일에서 함께 관리한다.
OAUTH_KAKAO_CLIENT_ID=
OAUTH_KAKAO_CLIENT_SECRET=
OAUTH_GOOGLE_CLIENT_ID=
OAUTH_GOOGLE_CLIENT_SECRET=
JWT_SECRET=

# S3 버킷·리전·자격증명. compose.yaml이 Spring 표준 키로 보간한다(ADR-0010).
AWS_REGION=
AWS_S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# AI 상상도 생성(GMS = OpenAI 프록시) 키. IMAGE_GENERATION_MODE=gms일 때만 필요하고
# 기본값은 stub이라 비워 둬도 배포된다 — 켠 채로 비면 앱이 기동 단계에서 멈춘다.
GMS_API_KEY=
# OpenAI 호환 오리진 (기본 https://api.openai.com, 프록시를 쓰면 그 주소)
IMAGE_GENERATION_BASE_URL=

# 상상도 생성 스위치 둘. 코드 수정·이미지 재빌드 없이 이 두 줄로 가른다(DERO-358).
#   IMAGE_GENERATION_MODE          stub(기본, 스크린샷을 그대로 3행에 꽂는다) | gms(실제 생성)
#   IMAGE_GENERATION_REQUEST_TYPE  edits(기본, 스크린샷을 입력 이미지로 보낸다) | generations(텍스트만)
# generations는 GMS 프록시가 multipart를 거부할 때의 강등 경로다.
IMAGE_GENERATION_MODE=
IMAGE_GENERATION_REQUEST_TYPE=

# GA4 Measurement ID(G-XXXXXXX). 비밀값은 아니지만(클라이언트에 어차피 노출) 배포 환경마다
# 속성이 달라 이 파일에서 관리한다. compose.yaml이 frontend 빌드 인자로 보간한다 — 비워두면
# NEXT_PUBLIC_* 빌드 타임 인라인 규약대로 GA 스크립트 자체가 비활성화된다.
NEXT_PUBLIC_GA_ID=

# Grafana 관리자 비밀번호. compose.observability.yaml만 읽는다(사람이 수동으로 올리는 계층).
# 비어 있으면 `up -d`가 즉시 멈춘다 — 기본값 admin/admin으로 뜬 뒤 서브도메인에 노출되는 경로를
# 만들지 않기 위해서다(ADR-0020 결정 4).
GRAFANA_ADMIN_PASSWORD=

# IMAGE_TAG는 여기 두지 않는다 — Jenkins가 $BUILD_NUMBER로 주입한다.