# imagine_img — DERO 데스크 셋업 실사화 로컬 AI Worker
# 이 파일을 imagine_img/.env 로 복사해서 쓴다. 값을 비워두면 아래 기본값이 적용된다.

# --- Runtime ---
APP_ENV=local
# 127.0.0.1 을 벗어나면 로컬 Worker 가 외부에 노출된다. 바꾸지 않는다.
HOST=127.0.0.1
PORT=8010
LOG_LEVEL=INFO
MAX_CONCURRENT_JOBS=1

# --- 모델 프로필 (§3) ---
# sdxl_lightning : 기본. SDXL Base + Lightning 8-step Full UNet, guidance_scale=0
# sdxl_photoreal : RealVisXL 등 실사 특화. CFG 켜짐 → 네거티브 프롬프트 작동. 기본 비활성
# sdxl_juggernaut: JuggernautXL 계열 비교용. 기본 비활성
MODEL_PROFILE=sdxl_lightning
DEVICE=cuda
DTYPE=float16

SDXL_BASE_MODEL_ID=stabilityai/stable-diffusion-xl-base-1.0
LIGHTNING_REPO_ID=ByteDance/SDXL-Lightning
# 8-step checkpoint 를 쓴다. steps=9 에서 strength 0.25/0.35/0.45 가 2/3/4 step 으로
# 갈라지려면 4-step 이 아니라 8-step 이어야 한다 (DESIGN_GAP_REPORT P2-3).
LIGHTNING_CHECKPOINT=sdxl_lightning_8step_unet.safetensors
LIGHTNING_VARIANT=unet
# 로컬 .safetensors 를 직접 쓸 때만 채운다. 비우면 허브에서 받는다.
SDXL_LIGHTNING_UNET_PATH=

# 실사 특화 프로필을 쓸 때만 채운다. 라이선스를 모델 카드 원문에서 확인한 뒤 넣을 것.
# 비어 있으면 해당 프로필 선택 시 즉시 실패한다 (자동 다운로드하지 않는다).
SDXL_PHOTOREAL_MODEL_ID=
SDXL_JUGGERNAUT_MODEL_ID=

# 비우면 프로필 값을 쓴다. 채우면 프로필을 덮어쓴다 (실험용).
# sdxl_lightning 프로필의 값: steps=9, guidance_scale=0.0, strength=0.35
INFERENCE_STEPS=
GUIDANCE_SCALE=
IMG2IMG_STRENGTH=

# --- ControlNet (기본 OFF) ---
# 구조를 조건 이미지로 고정한다. 켜면 strength 상한이 0.45 -> CONTROLNET_MAX_STRENGTH 로 올라간다.
# 켜는 이유: img2img 만으로는 "제품 보존"과 "실사 재질"이 strength 한 축에서 배타적이다
# (docs/QUALITY_GAP_ANALYSIS.md 원인 B). ControlNet 이 그 두 축을 분리한다.
ENABLE_CONTROLNET=false
# canny  : 입력 이미지만으로 만들 수 있고 제품 형태를 픽셀 단위로 고정한다 (opencv 필요)
# depth  : 깊이 맵이 필요하다. 시뮬레이터의 depth 버퍼를 주는 것이 가장 좋다
CONTROLNET_TYPE=canny
# small 변형(0.30GB) 필수급 권장. 표준 변형(2.4GB)은 8GB 에서 공유 메모리로 밀려나
# 추론이 27초 -> 130~180초가 된다 (실측).
CONTROLNET_MODEL_ID=diffusers/controlnet-canny-sdxl-1.0-small
# 0 = 조건 무시, 1 = 강하게 고정. 실측 최적점 0.6
#   0.35 -> 사진은 되지만 제품이 교체된다 (모니터→iMac)
#   0.60 -> 사진 + 제품/배치 유지  ← 권장
#   0.70+ -> 툰 윤곽선을 되살려 "선 안에 색칠"한 일러스트가 된다
CONTROLNET_CONDITIONING_SCALE=0.6
CANNY_LOW_THRESHOLD=80
CANNY_HIGH_THRESHOLD=180
CONTROLNET_MAX_STRENGTH=0.9
CONTROLNET_STRENGTH=0.75

# --- IP-Adapter (레퍼런스 사진을 조건으로, 2026-08-06) ---
# inputs/references/<카테고리>/ 의 실제 제품 사진을 생성에 물린다.
# 가중치는 scripts/download_models.py 가 받는다 (어댑터 0.7GB + CLIP 비전 인코더 2.5GB).
#
# 기본 OFF 다. 작동은 하지만(데스크매트가 레퍼런스 색으로 바뀐다) 레퍼런스가 흰 스튜디오
# 배경 컷이라 **화면 전체가 평평해진다** — 실측 laplacianVar 167.8(off) -> 116.3(0.3)
# -> 98.4(0.5). 실사화가 목표면 손해다. 근거와 재측정 방법은
# app/core/config.py `enable_ip_adapter` 주석 + scripts/compare_ip_adapter.py.
ENABLE_IP_ADAPTER=false
IP_ADAPTER_SCALE=0.3
IP_ADAPTER_MAX_REFERENCES=3

# --- 네거티브 프롬프트 (§10) ---
# full | compact | none
# 주의: guidance_scale <= 1 인 프로필(sdxl_lightning)에서는 CFG 가 꺼져 있어
# 네거티브 프롬프트가 아무 효과가 없다. 매 요청 응답에 경고로 남는다.
NEGATIVE_PROMPT_PROFILE=compact

# --- 프롬프트 파일 우회 (기본 비활성) ---
# 채우면 프롬프트를 이 파일에서 그대로 읽고, 데스크 실사화 문장 조합(구조 보존·조명·무드·
# 제품 목록)을 통째로 우회한다. 위 NEGATIVE_PROMPT_PROFILE 도 무시되고 파일의
# [negative] 블록이 쓰인다. 형식은 app/generation/prompt_file.py 참고.
#
# 여기에 박아두면 REST·큐 요청까지 다른 프롬프트로 돌아간다. 한 번만 쓸 거면 비워 두고
# CLI 에서 --prompt-file prompts/product_copyright_safe.txt 로 켜는 편이 안전하다.
PROMPT_FILE=

# --- Generation ---
# follow_input : 출력 크기 = 입력 이미지 크기. 생성 크기는 입력 비율에 맞춘 SDXL 친화 크기 (기본)
# fixed        : 생성 1152x1024, 최종 1328x1184 로 고정 (구 규격). 비율이 다른 입력은 거부한다
SIZE_MODE=follow_input
# 생성 픽셀 수 상한. 1152x1024 기준선. 올리면 품질이 오를 수 있지만 8GB 에서 OOM 위험이 커진다.
GENERATION_PIXEL_BUDGET=1179648
# 생성 크기를 맞출 배수. SDXL 은 64 가 안전하다.
SIZE_MULTIPLE=64

# 아래 4개는 SIZE_MODE=fixed 에서만 쓰인다.
GENERATION_WIDTH=1152
GENERATION_HEIGHT=1024
FINAL_WIDTH=1328
FINAL_HEIGHT=1184

DEFAULT_SEED=42
INPUT_MIN_SIZE=512
INPUT_MAX_BYTES=26214400
# fixed 모드에서만 적용된다. follow_input 은 비율을 입력에 맞추므로 거부하지 않는다.
ASPECT_RATIO_TOLERANCE=0.02

# --- Memory (8GB VRAM 기본 정책, §14) ---
MEMORY_MODE=model_cpu_offload
ENABLE_MODEL_CPU_OFFLOAD=true
ENABLE_VAE_TILING=true
ENABLE_VAE_SLICING=false
ENABLE_ATTENTION_SLICING=false
ENABLE_TORCH_COMPILE=false
# auto | true | false. xformers 미설치 환경에서는 auto 가 PyTorch SDPA 로 귀결된다.
ENABLE_XFORMERS=auto
# offload 를 쓰면 실행 디바이스가 옮겨다니므로 seed 재현을 위해 cpu generator 를 쓴다.
GENERATOR_DEVICE=cpu
WARMUP_SIZE=512

# --- LoRA (기본 OFF, §12) ---
ENABLE_LORA=false
LORA_PATH=
DERO_LORA_WEIGHT_NAME=
LORA_SCALE=0.6
FUSE_DERO_LORA=false

# --- Quantization (기본 none, fail-fast, §13) ---
# none | torchao_int8 | bnb_nf4_experimental
QUANTIZATION_MODE=none
ALLOW_EXPERIMENTAL_QUANTIZATION=false
QUANTIZATION_FALLBACK=fail

# --- Postprocess (§11) ---
RESAMPLE_FILTER=lanczos
ENABLE_SHARPEN=false
SHARPEN_RADIUS=0.8
SHARPEN_PERCENT=40
SHARPEN_THRESHOLD=3
SAVE_OPTIMIZE_PNG=false
# PNG 원본은 항상 저장된다. true 면 전달용 WebP 를 추가로 만든다.
SAVE_WEBP=false
WEBP_QUALITY=92

# --- Storage ---
OUTPUT_DIR=./outputs
MODEL_CACHE_DIR=./model-cache
# simulatorViewPath 로 받은 경로는 이 디렉터리 하위로만 허용한다.
INPUT_DIR=./inputs

# --- 실험 플래그 ---
# img2img 는 실제 denoise step 이 int(steps*strength) 로 줄어든다.
# true 면 실제 step 이 요청 step 과 같아지도록 올린다. distilled 모델의 학습 조건에서
# 벗어나므로 기본 false.
COMPENSATE_STEPS_FOR_STRENGTH=false
