# End of https://www.toptal.com/developers/gitignore/api/visualstudiocode,intellij,java,node

# Claude Code 개인 설정 (팀 공유 안 함)
.claude/settings.local.json

# Serena 로컬 캐시·개인 설정 (project.yml은 커밋)
/.serena/cache/
/.serena/project.local.yml

# Firecrawl 스크래핑 결과 캐시 (로컬 작업물, 커밋 금지)
.firecrawl/

# Playwright 산출물 (스크린샷·리포트 — 커밋 금지)
test-results/
playwright-report/

# 수동 시각 QA 스크린샷 (증빙용 로컬 보관 — 커밋 금지)
qa-artifacts/

# 도구 산출물
.gstack/

# asset-pipeline.sh 가 찾는 gltfpack 네이티브 바이너리 드롭 위치 (3.9MB — 커밋 금지)
scripts/.bin/

# serena 에이전트 메모리 — 세션마다 자동 갱신되어 MR 노이즈가 됨 (project.yml은 커밋 대상)
.serena/memories/

# ERD 동결 언락 토큰 — 30분 유효한 로컬 승인 창 (기준선 .claude/erd-baseline.sha256은 커밋)
.claude/.erd-unlock

# 다이어그램 뷰어 HTML — 렌더 산출물이라 커밋하지 않는다 (DERO-516)
docs/context/diagrams/*.html

# graphify 재생성 가능 산출물 (DERO-554)
# AST 캐시는 LLM 없이 수 초면 다시 만들어지는데 28MB·690파일이라 매 실행마다 MR을 덮는다.
# semantic 캐시(cache/semantic/)는 LLM 추출 결과라 커밋한다 — 한 번 만드는 데 170만 토큰 든다.
graphify-out/cache/ast/
graphify-out/cache/stat-index.json
graphify-out/cache/last_query_stamp
# 로컬 절대경로가 박히는 파일 — 머신마다 달라 충돌만 낸다
graphify-out/.graphify_python
graphify-out/.graphify_root
# 파이프라인이 매 실행 만들고 지우는 임시 파일
graphify-out/.graphify_incremental.json

# 브랜드 필름 미디어 — 262MB(개념 이미지·샷 영상). 문서만 커밋한다.
# 원본은 Higgsfield에 남아 있고 media/job id가 docs/brand-film/README.md에 적혀 있다.
docs/brand-film/concepts/
docs/brand-film/shots/
docs/brand-film/*.zip

