        "result": "CONDITIONAL",
        "reasonCount": 1,
        "reasonContains": ["VESA 규격 미등록"]
      }
    },
    {
      "name": "암 허용 하중 미등록 — 조건부",
      "monitor": { "vesa": ["100x100"], "weightG": 4200 },
      "arm": { "vesa": ["100x100"], "loadCapacityG": null },
      "expected": {
        "result": "CONDITIONAL",
        "reasonCount": 1,
        "reasonContains": ["무게·허용 하중 규격 미등록"]
