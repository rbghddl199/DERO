      }
    },
    {
      "name": "클램프 최대만 미등록 — 조건부 (한쪽 결측도 무한대 치환 금지)",
      "arm": { "isClampMountable": true, "clampMinMm": 10, "clampMaxMm": null },
      "desk": { "topThicknessMm": 25, "edgeThicknessMm": 25 },
      "expected": {
        "result": "CONDITIONAL",
        "reasonCount": 1,
