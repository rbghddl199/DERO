      }
    },
    {
      "name": "클램프 마운트 불가 암 — 판정 행 없음 (불가가 아니다)",
      "arm": { "isClampMountable": false, "clampMinMm": null, "clampMaxMm": null },
      "desk": { "topThicknessMm": 100, "edgeThicknessMm": 100 },
      "expected": null
    },
    {
      "name": "클램프 규격이 있어도 게이트가 false면 판정하지 않는다",
      "arm": { "isClampMountable": false, "clampMinMm": 10, "clampMaxMm": 40 },
      "desk": { "topThicknessMm": 25, "edgeThicknessMm": 25 },
      "expected": null
    }
  ],
  "monitorArm": [
    {
      "name": "VESA 교집합 있고 하중 여유 — 적합",
      "monitor": { "vesa": ["100x100"], "weightG": 4200 },
      "arm": { "vesa": ["75x75", "100x100"], "loadCapacityG": 5000 },
      "expected": { "result": "FIT", "reasonCount": 0, "reasonContains": [] }
    },
    {
      "name": "무게 == 허용 하중 — 경계 적합",
