    {
      "name": "VESA·무게 양쪽 미등록 — 조건부 사유 2건",
      "monitor": { "vesa": [], "weightG": null },
      "arm": { "vesa": [], "loadCapacityG": null },
      "expected": {
        "result": "CONDITIONAL",
        "reasonCount": 2,
