      "expected": {
        "result": "INCOMPATIBLE",
        "reasonCount": 1,
        "reasonContains": ["모니터 7.1kg", "허용 5kg"]
      }
    },
    {
      "name": "모니터가 여러 규격을 지원하고 그중 하나가 맞으면 적합",
      "monitor": { "vesa": ["75x75", "200x200"], "weightG": 3000 },
      "arm": { "vesa": ["200x200"], "loadCapacityG": 5000 },
      "expected": { "result": "FIT", "reasonCount": 0, "reasonContains": [] }
    },
    {
      "name": "VESA 불일치 + 하중 초과 — 사유 2건",
      "monitor": { "vesa": ["200x200"], "weightG": 9000 },
      "arm": { "vesa": ["100x100"], "loadCapacityG": 5000 },
      "expected": {
        "result": "INCOMPATIBLE",
        "reasonCount": 2,
        "reasonContains": ["VESA 200×200", "모니터 9kg", "허용 5kg"]
      }
    },
    {
      "name": "모니터 VESA 미등록 — 조건부",
