      "expected": { "result": "FIT", "reasonCount": 0, "reasonContains": [] }
    },
    {
      "name": "VESA 불일치 — 불가",
      "monitor": { "vesa": ["75x75"], "weightG": 4200 },
      "arm": { "vesa": ["100x100"], "loadCapacityG": 5000 },
      "expected": {
        "result": "INCOMPATIBLE",
        "reasonCount": 1,
        "reasonContains": ["VESA 75×75", "불일치"]
      }
    },
    {
      "name": "허용 하중 초과 — 불가",
      "monitor": { "vesa": ["100x100"], "weightG": 7100 },
