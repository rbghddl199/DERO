    },
    {
      "name": "VESA 미등록 + 하중 초과 — 확인된 불가가 조건부를 이긴다",
      "monitor": { "vesa": [], "weightG": 7100 },
      "arm": { "vesa": ["100x100"], "loadCapacityG": 5000 },
      "expected": {
        "result": "INCOMPATIBLE",
        "reasonCount": 2,
        "reasonContains": ["모니터 7.1kg", "허용 5kg", "VESA 규격 미등록"]
