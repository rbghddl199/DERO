{
  "name": "frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "predev": "node scripts/sync-admin-guide.mjs",
    "dev": "next dev",
    "prebuild": "node scripts/sync-admin-guide.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "node --max-old-space-size=4096 ./node_modules/typescript/bin/tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "api:types": "npx -y openapi-typescript http://localhost:8080/v3/api-docs -o src/types/openapi.d.ts",
    "assets:build": "gltfpack -cc -tc -kn -km -si 0.35 -i \"assets-raw/Meshy_AI_White Adjustable Monitor Arm_1784342650_part-segmentation.glb\" -o public/assets/monitor-arm.glb && gltfpack -cc -tc -tl 1024 -i assets-raw/Meshy_AI_Blue_Abstract_Waves_0718033043_texture.glb -o assets-raw/.waves-1024.tmp.glb && npx @gltf-transform/cli simplify assets-raw/.waves-1024.tmp.glb assets-raw/.waves-simp.tmp.glb --ratio 0.2 --error 0.001 && gltfpack -cc -vp 12 -vt 10 -i assets-raw/.waves-simp.tmp.glb -o public/assets/waves-decor.glb && rm assets-raw/.waves-1024.tmp.glb assets-raw/.waves-simp.tmp.glb",
    "assets:build:library": "node scripts/build-library-assets.mjs",
    "assets:thumbnails": "node scripts/generate-thumbnails.mjs"
  },
  "dependencies": {
    "@gsap/react": "^2.1.2",
    "@jsquash/webp": "^1.5.0",
    "@next/third-parties": "^16.2.10",
    "@react-three/fiber": "^9.6.1",
    "@tiptap/core": "^3.29.2",
    "@tiptap/extension-image": "^3.29.2",
    "@tiptap/extension-placeholder": "^3.29.2",
    "@tiptap/extension-text-align": "^3.29.2",
    "@tiptap/extension-text-style": "^3.29.2",
    "@tiptap/pm": "^3.29.2",
    "@tiptap/react": "^3.29.2",
    "@tiptap/starter-kit": "^3.29.2",
    "framer-motion": "12.42.2",
    "gsap": "^3.15.0",
    "hast-util-sanitize": "^5.0.2",
    "next": "16.2.10",
    "pretendard": "^1.3.9",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-markdown": "^10.1.0",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "three": "^0.185.1",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@playwright/test": "1.61.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "0.185.1",
    "eslint": "^9",
    "eslint-config-next": "16.2.10",
    "eslint-config-prettier": "^10.1.8",
    "openapi-typescript": "^7.13.0",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "4.1.10"
  }
}
