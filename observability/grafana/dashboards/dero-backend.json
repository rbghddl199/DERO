{
  "uid": "dero-backend",
  "title": "dero-api 지표",
  "description": "Spring Boot(Micrometer) 지표. 지표 선택 근거는 ADR-0020 결정 9. 지연은 sum/count 평균과 클라이언트 사이드 percentiles(p95·p99) 둘 다 본다 — percentiles-histogram은 켜지 않으므로 histogram_quantile은 빈 값이다.",
  "tags": ["dero", "backend"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 2,
  "refresh": "30s",
  "time": { "from": "now-6h", "to": "now" },
  "panels": [
    {
      "id": 7,
      "type": "stat",
      "title": "생존 (스크레이프 상태)",
      "description": "Prometheus가 붙인 값이라 앱이 안 뱉어도 나온다. 아래 패널이 전부 비었을 때 앱이 죽은 것(0)인지 수집만 끊긴 것(값 없음)인지 여기서만 갈린다. 앱이 죽는 순간의 값은 남지 않는다 — 마지막 스크레이프까지가 전부다(15초 간격).",
      "gridPos": { "h": 3, "w": 24, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "dero-prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "max": 1,
          "mappings": [
            { "type": "value", "options": { "0": { "text": "DOWN", "color": "red", "index": 0 } } },
            { "type": "value", "options": { "1": { "text": "UP", "color": "green", "index": 1 } } }
          ]
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value_and_name",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "dero-prometheus" },
          "expr": "up{job=\"dero-backend\"}",
          "legendFormat": "{{instance}}"
        }
      ]
    },
    {
      "id": 1,
      "type": "timeseries",
      "title": "요청량 (status별 rps)",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 3 },
      "datasource": { "type": "prometheus", "uid": "dero-prometheus" },
      "fieldConfig": {
        "defaults": { "unit": "reqps", "min": 0 },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "dero-prometheus" },
          "expr": "sum by (status) (rate(http_server_requests_seconds_count{job=\"dero-backend\"}[5m]))",
          "legendFormat": "{{status}}"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "5xx 발생률",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 3 },
      "datasource": { "type": "prometheus", "uid": "dero-prometheus" },
      "fieldConfig": {
        "defaults": { "unit": "reqps", "min": 0 },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "dero-prometheus" },
          "expr": "sum by (uri) (rate(http_server_requests_seconds_count{job=\"dero-backend\",outcome=\"SERVER_ERROR\"}[5m]))",
          "legendFormat": "{{uri}}"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "평균 응답시간 (uri별)",
      "description": "sum/count 평균이다. 꼬리는 이 패널이 아니라 아래 p95·p99 패널에서 본다 — 평균만 보면 3초 꼬리가 400ms로 읽힌다.",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 11 },
      "datasource": { "type": "prometheus", "uid": "dero-prometheus" },
      "fieldConfig": {
        "defaults": { "unit": "s", "min": 0 },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "dero-prometheus" },
          "expr": "sum by (uri) (rate(http_server_requests_seconds_sum{job=\"dero-backend\"}[5m])) / sum by (uri) (rate(http_server_requests_seconds_count{job=\"dero-backend\"}[5m]))",
          "legendFormat": "{{uri}}"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "JVM 힙",
      "description": "힙에 여유가 있는데 컨테이너가 죽었으면 원인은 여기가 아니라 아래 '힙 밖 메모리' 패널이다.",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 11 },
      "datasource": { "type": "prometheus", "uid": "dero-prometheus" },
      "fieldConfig": {
        "defaults": { "unit": "bytes", "min": 0 },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "dero-prometheus" },
          "expr": "sum(jvm_memory_used_bytes{job=\"dero-backend\",area=\"heap\"})",
          "legendFormat": "used"
        },
        {
          "refId": "B",
          "datasource": { "type": "prometheus", "uid": "dero-prometheus" },
          "expr": "sum(jvm_memory_max_bytes{job=\"dero-backend\",area=\"heap\"})",
          "legendFormat": "max"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "CPU 사용률",
      "description": "system_cpu_usage는 컨테이너가 아니라 호스트 전체다 — EC2 1대에 nginx·Jenkins·Next.js가 같이 있으므로 배포 중 스파이크는 정상이다.",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 19 },
      "datasource": { "type": "prometheus", "uid": "dero-prometheus" },
      "fieldConfig": {
        "defaults": { "unit": "percentunit", "min": 0, "max": 1 },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "dero-prometheus" },
          "expr": "process_cpu_usage{job=\"dero-backend\"}",
          "legendFormat": "process"
        },
        {
          "refId": "B",
          "datasource": { "type": "prometheus", "uid": "dero-prometheus" },
          "expr": "system_cpu_usage{job=\"dero-backend\"}",
          "legendFormat": "system"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "DB 커넥션 풀 (HikariCP)",
      "description": "pending이 0을 벗어나 유지되면 풀 크기가 아니라 느린 쿼리를 먼저 본다.",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 19 },
      "datasource": { "type": "prometheus", "uid": "dero-prometheus" },
      "fieldConfig": {
        "defaults": { "unit": "short", "min": 0 },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "dero-prometheus" },
          "expr": "hikaricp_connections_active{job=\"dero-backend\"}",
          "legendFormat": "active"
        },
        {
          "refId": "B",
          "datasource": { "type": "prometheus", "uid": "dero-prometheus" },
          "expr": "hikaricp_connections_pending{job=\"dero-backend\"}",
          "legendFormat": "pending"
        },
        {
          "refId": "C",
          "datasource": { "type": "prometheus", "uid": "dero-prometheus" },
          "expr": "hikaricp_connections_max{job=\"dero-backend\"}",
          "legendFormat": "max"
        }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "응답시간 p95 · p99 (uri별)",
      "description": "클라이언트 사이드 percentiles다(application.yaml management.metrics.distribution.percentiles). quantile 시계열은 method·status·outcome까지 갈라져 있어 uri별 최악값으로 줄여 읽는다 — 이 값은 재집계 불가라 여러 시계열을 sum/avg하면 틀린 수가 나온다.",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 27 },
      "datasource": { "type": "prometheus", "uid": "dero-prometheus" },
      "fieldConfig": {
        "defaults": { "unit": "s", "min": 0 },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "dero-prometheus" },
          "expr": "max by (uri) (http_server_requests_seconds{job=\"dero-backend\",quantile=\"0.95\"})",
          "legendFormat": "p95 {{uri}}"
        },
        {
          "refId": "B",
          "datasource": { "type": "prometheus", "uid": "dero-prometheus" },
          "expr": "max(http_server_requests_seconds{job=\"dero-backend\",quantile=\"0.99\"})",
          "legendFormat": "p99 (전체 최악)"
        }
      ]
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "GC 일시정지",
      "description": "힙 톱니만 보면 GC 스톨이 안 보인다. '초/초'는 벽시계 시간 중 GC로 멈춘 비율이고(0.01 = 1%), '최대 일시정지'는 스크레이프 구간의 최댓값이라 15초보다 짧게 사라진 스파이크는 여기에도 안 남는다.",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 27 },
      "datasource": { "type": "prometheus", "uid": "dero-prometheus" },
      "fieldConfig": {
        "defaults": { "unit": "s", "min": 0 },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "dero-prometheus" },
          "expr": "max(jvm_gc_pause_seconds_max{job=\"dero-backend\"})",
          "legendFormat": "최대 일시정지"
        },
        {
          "refId": "B",
          "datasource": { "type": "prometheus", "uid": "dero-prometheus" },
          "expr": "sum(rate(jvm_gc_pause_seconds_sum{job=\"dero-backend\"}[5m]))",
          "legendFormat": "초/초 (스톨 비율)"
        }
      ]
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "힙 밖 메모리 (비힙 · direct buffer)",
      "description": "swap이 0이고 컨테이너에 mem_limit가 걸려 있어(observability.md §2·§3) OOM kill의 기준은 힙이 아니라 RSS다 — 힙 패널만 보면 '여유 있었는데 왜 죽었지'로 끝난다. direct buffer를 같이 보는 이유는 AWS S3 SDK가 그 영역을 쓰기 때문이다.",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 35 },
      "datasource": { "type": "prometheus", "uid": "dero-prometheus" },
      "fieldConfig": {
        "defaults": { "unit": "bytes", "min": 0 },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "dero-prometheus" },
          "expr": "sum(jvm_memory_used_bytes{job=\"dero-backend\",area=\"nonheap\"})",
          "legendFormat": "비힙 합계"
        },
        {
          "refId": "B",
          "datasource": { "type": "prometheus", "uid": "dero-prometheus" },
          "expr": "sum by (id) (jvm_buffer_memory_used_bytes{job=\"dero-backend\"})",
          "legendFormat": "buffer {{id}}"
        }
      ]
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "에러 로그 발생률",
      "description": "HTTP 지표가 못 보는 실패를 여기서 본다 — 비동기 이미지 파이프라인(ImagePublishQueue 워커)이 터져도 5xx도 지연도 움직이지 않는다. 요청 밖에서 죽는 실패의 유일한 지표다.",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 35 },
      "datasource": { "type": "prometheus", "uid": "dero-prometheus" },
      "fieldConfig": {
        "defaults": { "unit": "ops", "min": 0 },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "dero-prometheus" },
          "expr": "sum(rate(logback_events_total{job=\"dero-backend\",level=\"error\"}[5m]))",
          "legendFormat": "error"
        },
        {
          "refId": "B",
          "datasource": { "type": "prometheus", "uid": "dero-prometheus" },
          "expr": "sum(rate(logback_events_total{job=\"dero-backend\",level=\"warn\"}[5m]))",
          "legendFormat": "warn"
        }
      ]
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "커넥션 획득 대기 · 타임아웃",
      "description": "위 pending 패널의 짝이다. pending은 순간값이라 스크레이프 사이에 지나간 포화를 놓치는데, 타임아웃은 카운터라 한 건도 안 사라진다 — 타임아웃이 0을 벗어나면 풀 고갈이 이미 사용자에게 500으로 나간 것이다.",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 43 },
      "datasource": { "type": "prometheus", "uid": "dero-prometheus" },
      "fieldConfig": {
        "defaults": { "unit": "s", "min": 0 },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "타임아웃 (건/초)" },
            "properties": [
              { "id": "unit", "value": "ops" },
              { "id": "custom.axisPlacement", "value": "right" }
            ]
          }
        ]
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "dero-prometheus" },
          "expr": "hikaricp_connections_acquire_seconds_max{job=\"dero-backend\"}",
          "legendFormat": "획득 대기 최대"
        },
        {
          "refId": "B",
          "datasource": { "type": "prometheus", "uid": "dero-prometheus" },
          "expr": "sum(rate(hikaricp_connections_timeout_total{job=\"dero-backend\"}[5m]))",
          "legendFormat": "타임아웃 (건/초)"
        }
      ]
    }
  ]
}
