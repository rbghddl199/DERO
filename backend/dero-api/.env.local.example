# 복사해서 `.env.local`로 쓴다(gitignore). application-local.yaml의
# spring.config.import가 읽는다.
#
# !!! 키는 반드시 Spring 프로퍼티 키다 — 셸 스타일 대문자·언더스코어가 아니다.
# 완화 바인딩(relaxed binding)은 환경변수 소스에만 적용되고 프로퍼티 파일 키는
# 문자 그대로 읽힌다. OAUTH_KAKAO_CLIENT_SECRET=x 라고 쓰면 에러 없이 아무 데도
# 안 붙는다(ADR-0010 결정 4).
#
# !!! registration은 통째로 채우거나 통째로 비워라. 한 provider의 값을 일부만
# 채우면 부팅이 죽는다 — `Client id of registration 'kakao' must not be empty.`
# (2026-07-27 실측). 파일이 아예 없으면 registration이 안 생겨 정상 부팅한다.
#
# client-id는 비밀이 아니지만(OAuth 흐름에서 브라우저에 노출된다) 반쪽짜리
# registration을 막으려고 secret과 같은 파일에 둔다.

spring.security.oauth2.client.registration.kakao.client-id=
spring.security.oauth2.client.registration.kakao.client-secret=
spring.security.oauth2.client.registration.google.client-id=
spring.security.oauth2.client.registration.google.client-secret=

# S3 presigned 업로드용(product 대표이미지). 셸 환경변수가 아니라 이 파일에 적어야 한다 —
# AWS SDK 기본 자격증명 체인이 아니라 application.yaml의 app.storage.s3.*가 이 값을 읽는다
# (S3Config 참고).
AWS_S3_BUCKET=
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ─────────────────────────────────────────────────────────────────────
# 운영 DB 붙기 (에러 재현용) — 평소엔 지운 채로 둔다
#
# spring.config.import로 읽힌 이 파일은 application-local.yaml보다 우선순위가
# 높다. 아래 키를 채우면 로컬 컨테이너 대신 운영 DB에 붙는다. 절차·경고 전문은
# docs/context/deployment.md §9.
#
# !!! spring.flyway.enabled=false 를 반드시 같이 넣어라. 안 넣으면 로컬 부팅이
# 운영 스키마에 마이그레이션을 적용한다(되돌릴 수 없다). 지금은 V1 하나뿐이라
# 체크섬만 맞으면 no-op이지만, 누가 V2를 추가하는 날 조용히 터진다.
#
# !!! 포트는 5432를 피한다 — 로컬 컨테이너가 이미 쓴다. 어느 DB에 붙었는지
# 모르는 상태가 된다. 터널: ssh -N -L 55432:127.0.0.1:5432 ubuntu@www.dero.life
#
# spring.datasource.url=jdbc:postgresql://localhost:55432/dero_be
# spring.datasource.username=<운영 POSTGRES_USER>
# spring.datasource.password=<운영 POSTGRES_PASSWORD>
# spring.flyway.enabled=false
