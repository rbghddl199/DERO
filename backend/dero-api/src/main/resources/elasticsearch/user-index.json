{
  "settings": {
    "index": {
      "number_of_shards": 1,
      "number_of_replicas": 0
    },
    "analysis": {
      "tokenizer": {
        "nori": {
          "type": "nori_tokenizer",
          "decompound_mode": "mixed"
        },
        "nickname_edge_ngram": {
          "type": "edge_ngram",
          "min_gram": 2,
          "max_gram": 20,
          "token_chars": ["letter", "digit"]
        }
      },
      "analyzer": {
        "korean": {
          "type": "custom",
          "tokenizer": "nori",
          "filter": ["lowercase"]
        },
        "korean_edge_ngram": {
          "type": "custom",
          "tokenizer": "nickname_edge_ngram",
          "filter": ["lowercase"]
        }
      }
    }
  },
  "mappings": {
    "properties": {
      "nickname": {
        "type": "text",
        "analyzer": "korean",
        "fields": {
          "autocomplete": {
            "type": "text",
            "analyzer": "korean_edge_ngram",
            "search_analyzer": "korean"
          }
        }
      }
    }
  }
}
